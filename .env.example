# Copy this file to .env (for `vercel dev`) and fill in your own key.
# Get a key at https://platform.openai.com/api-keys — billing must be
# enabled on the account (Settings -> Billing) for audio.speech requests
# to succeed.
OPENAI_API_KEY=

# Optional overrides — leave unset to use the defaults in api/tts.js.
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
OPENAI_TTS_INSTRUCTIONS=
